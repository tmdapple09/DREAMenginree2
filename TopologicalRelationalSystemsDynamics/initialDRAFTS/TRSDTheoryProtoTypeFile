  \label{eq:activation}
\end{equation}
The one-dimensional current response is $J_{\rm 1D}(g) = g\,f(g) = g^2/(g+\ac)$.
In dimensionless units $x = g/\ac$:
\begin{equation}
  j(x) = \frac{x^2}{1+x}.
  \label{eq:1d_current}
\end{equation}
For an isotropically distributed force field, the radial response is computed by
averaging over all directions. Writing the projected component along the radial axis
as $g_\parallel = g\,u$ with $u = \cos\theta$:
\begin{equation}
  \sigma(x) = 3\int_0^1 \frac{(xu)^2}{1+xu}\,u\,du = 3x^2\int_0^1\frac{u^3}{1+xu}\,du.
  \label{eq:sigma_integral}
\end{equation}
The factor $u$ in the measure is the cosine weight from the solid angle element
$d\Omega = 2\pi\sin\theta\,d\theta$, and the factor $3$ restores the three-dimensional
normalization. Polynomial long division gives
\begin{equation}
  \frac{u^3}{1+xu} = \frac{u^2}{x} - \frac{u}{x^2} + \frac{1}{x^3}
                     - \frac{1}{x^3(1+xu)}.
  \label{eq:long_division}
\end{equation}
Integrating term by term over $u \in [0,1]$:
\begin{equation}
  \int_0^1\frac{u^3}{1+xu}\,du
  = \frac{1}{3x} - \frac{1}{2x^2} + \frac{1}{x^3} - \frac{\ln(1+x)}{x^4}.
  \label{eq:integral_result}
\end{equation}
Multiplying by $3x^2$:
\begin{equation}
  \boxed{\sigma(x) = x - \frac{3}{2} + \frac{3}{x} - \frac{3\ln(1+x)}{x^2}.}
  \label{eq:sigma}
\end{equation}
The effective interpolation function is
\begin{equation}
  \boxed{\mueff(x) = \frac{\sigma(x)}{x}
    = 1 - \frac{3}{2x} + \frac{3}{x^2} - \frac{3\ln(1+x)}{x^3}.}
  \label{eq:mueff}
\end{equation}
The limiting behaviors are:
\begin{itemize}
  \item \textbf{Deep-MOND limit} ($x\to 0$):
    From equation~\eqref{eq:sigma_integral}, $\sigma(x)/x \to 3\int_0^1 u^3\,du = 3/4$,
    hence
    \begin{equation}
      \boxed{\mueff(x) \;\sim\; \tfrac{3}{4}\,x \quad (x \to 0).}
      \label{eq:mueff_IR}
    \end{equation}
  \item \textbf{Newtonian limit} ($x\to\infty$):
    \begin{equation}
      \boxed{\mueff(x) \to 1 \quad (x\to\infty).}
      \label{eq:mueff_UV}
    \end{equation}
\end{itemize}
The coefficient $3/4$ is determined entirely by isotropy (Section~\ref{sec:vacuum})
and the three-dimensional angular integration; no free parameter is involved. The
logarithmic term $-3\ln(1+x)/x^3$ is a distinctive prediction absent from standard
MOND interpolation functions.

