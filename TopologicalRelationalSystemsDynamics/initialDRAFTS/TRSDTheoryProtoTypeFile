\section{Downstream Derivations After the Corrected Defect Relation}
\label{sec:downstream}
All results below follow from the corrected defect map
\begin{equation}
\delta = \frac{8\pi G M}{c^2 R_H},
\end{equation}
and the associated scalar normalization
\begin{equation}
f_\delta^2 = \frac{\delta c^4}{8\pi G} = \frac{Mc^2}{R_H} = McH_0 .
\end{equation}
\subsection{Defect Length and Dark Matter Mass}
The conical deficit removes a missing arc on the horizon boundary at radius
$R_H$. The missing arc length is
\begin{equation}
L_* = \delta R_H .
\end{equation}
Substituting the corrected defect relation:
\begin{equation}
L_* = \frac{8\pi G M}{c^2 R_H} R_H = \frac{8\pi G M}{c^2}.
\end{equation}
The dark matter scalar field is a radial fluctuation whose characteristic
wavelength is set by this geometric defect length. Its mass is therefore
\begin{equation}
m_\delta = \frac{\sqrt{8}\,\hbar}{c L_*} ,
\end{equation}
where $\sqrt{8}$ comes from the vacuum curvature of the stable potential
$V(\Xi)=\frac12(\Xi-2)^2+2$ at $\Xi=2$. In canonical normalization the
dimensionless mass squared is $8$, and the physical mass is obtained by
identifying the inverse Compton wavelength with $L_*$:
\begin{equation}
\frac{\hbar}{m_\delta c} = L_* .
\end{equation}
Thus
\begin{equation}
m_\delta = \frac{\sqrt{8}\,\hbar}{c L_*} .
\end{equation}
\subsection{Scale Duality}
Using the derived $L_*$,
\begin{equation}
M m_\delta
= M \frac{\sqrt{8}\,\hbar}{c} \frac{c^2}{8\pi G M}
= \frac{\sqrt{8}\,\hbar c}{8\pi G}
= \frac{\sqrt{8}}{8\pi} m_P^2 .
\end{equation}
No free parameters remain.
\subsection{Information--Energy Equivalence}
The horizon information is
\begin{equation}
I = \frac{\delta}{2\pi}N,
\qquad
N = \frac{2\pi R_H^2}{\ell_P^2}
= \frac{2\pi R_H^2 c^3}{\hbar G}.
\end{equation}
Eliminating $\delta$ using the corrected defect map gives
\begin{equation}
\delta = \frac{2\pi I}{N} .
\end{equation}
The energy is
\begin{equation}
E = Mc^2
= \frac{\delta c^4 R_H}{8\pi G}
= \frac{2\pi I}{N}\frac{c^4 R_H}{8\pi G}.
\end{equation}
Substituting $N$:
\begin{equation}
E
= \frac{\hbar c}{8\pi R_H} I .
\end{equation}
Therefore
\begin{equation}
\boxed{E = \frac{\hbar c}{8\pi R_H} I .}
\end{equation}
\subsection{Dark Energy Information Density}
For the total horizon deficit $\delta_{\rm total}=\pi$,
\begin{equation}
I = \frac{\pi}{2\pi}N = \frac{N}{2}
= \frac{\pi R_H^2 c^3}{\hbar G}.
\end{equation}
Then
\begin{equation}
E = \frac{\hbar c}{8\pi R_H} \frac{\pi R_H^2 c^3}{\hbar G}
= \frac{c^4 R_H}{8G}.
\end{equation}
Using the effective hemisphere volume
\begin{equation}
V_{\rm eff} = \frac{2}{3}\pi R_H^3,
\end{equation}
the information energy density is
\begin{equation}
\rho_{\rm DE}^{\rm info}
= \frac{E}{V_{\rm eff}}
= \frac{3c^4}{16\pi G R_H^2}.
\end{equation}
The generator-defect dark energy density is
\begin{equation}
\rho_{\rm DE}^{\rm gen}
= \frac{1}{\delta_{\rm gen}}\frac{f_\pi^2}{R_H^2}
= \frac{3}{\pi}\frac{c^4}{8 G R_H^2}
= \frac{3c^4}{8\pi G R_H^2}.
\end{equation}
Thus
\begin{equation}
\rho_{\rm DE}^{\rm info}
= \frac12 \rho_{\rm DE}^{\rm gen}.
\end{equation}
\subsection{Unchanged Derived Quantities}
The critical acceleration $a_c$, the MOND scale $a_0$, the threshold
distribution, the modified Poisson equation, screening, and the terminal
attractor do not depend on the mass-defect relation. They remain as derived
earlier.
\subsection{Dimensional Consistency}
All equations above are dimensionally consistent:
\begin{itemize}
\item $\delta$ is dimensionless.
\item $L_*$ has units of length.
\item $m_\delta$ has units of mass.
\item $E$ has units of energy.
\item $\rho_{\rm DE}$ has units of energy density.
\end{itemize}

