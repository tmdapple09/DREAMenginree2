{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/tsconfig.games.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "components/games/**/*.ts",
    "components/games/**/*.tsx",
    "components/gameengin/**/*.ts",
    "components/gameengin/**/*.tsx",
    "lib/games/**/*.ts",
    "lib/games/**/*.tsx",
    "lib/gameengin/**/*.ts",
    "lib/gameengin/**/*.tsx",
    "app/gameengin/**/*.ts",
    "app/gameengin/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "tests/**",
    "app/api/**",
    "lib/gameengin/brain/**",
    "lib/gameengin/brain-reader.ts"
  ]
}
